// Xenos Predictions — schema.prisma
//
// Design principles (carried over from the original spec):
//  - Integer micro-point accounting everywhere money-like values are
//    stored — no Float/Decimal for balances, shares, or settlement.
//    1 "point" = 1_000_000 micro-points internally, to give LMSR room
//    for fractional share math without ever touching floating point
//    in a persisted column.
//  - Admins must hold zero positions in a market before they can
//    resolve it — enforced in application code (see lib/resolve.ts),
//    but the schema keeps an auditable, insert-only resolution log
//    so that rule is checkable after the fact too.
//  - Every trade carries a client-generated idempotency key so a
//    retried request never double-executes.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MarketStatus {
  DRAFT
  OPEN
  CLOSED
  RESOLVED
  VOID
}

enum MarketCategory {
  MACRO
  CENTRAL_BANKS
  FX
  COMMODITIES
  RATES
  GEOPOLITICS
}

enum Outcome {
  YES
  NO
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  displayName   String
  createdAt     DateTime @default(now())

  xenosPremium  Boolean  @default(false)
  premiumSyncedAt DateTime?

  isAdmin       Boolean  @default(false)

  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastTradeDate DateTime?

  badges        UserBadge[]
  payouts       Payout[]

  pointsBalance BigInt   @default(1000000000)

  positions     Position[]
  trades        Trade[]
  createdMarkets Market[] @relation("MarketCreator")
  resolutions   Resolution[]

  @@index([email])
}

model Market {
  id            String         @id @default(cuid())
  slug          String         @unique
  question      String
  description   String         @db.Text
  category      MarketCategory
  status        MarketStatus   @default(DRAFT)

  liquidityB    BigInt

  qYes          BigInt         @default(0)
  qNo           BigInt         @default(0)

  closesAt      DateTime
  resolvesAt    DateTime?

  resolvedOutcome Outcome?
  resolvedAt      DateTime?
  settledAt       DateTime?

  creatorId     String
  creator       User           @relation("MarketCreator", fields: [creatorId], references: [id])

  positions     Position[]
  trades        Trade[]
  resolution    Resolution?
  payouts       Payout[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([category])
  @@index([closesAt])
}

model Position {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  outcome   Outcome

  shares    BigInt   @default(0)

  user      User     @relation(fields: [userId], references: [id])
  market    Market   @relation(fields: [marketId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([userId, marketId, outcome])
  @@index([marketId])
}

model Trade {
  id              String   @id @default(cuid())
  userId          String
  marketId        String
  outcome         Outcome
  side            String

  sharesDelta     BigInt
  pointsDelta     BigInt

  qYesBefore      BigInt
  qNoBefore       BigInt
  qYesAfter       BigInt
  qNoAfter        BigInt

  idempotencyKey  String   @unique

  user            User     @relation(fields: [userId], references: [id])
  market          Market   @relation(fields: [marketId], references: [id])

  createdAt       DateTime @default(now())

  @@index([marketId])
  @@index([userId])
}

model Resolution {
  id              String   @id @default(cuid())
  marketId        String   @unique
  market          Market   @relation(fields: [marketId], references: [id])

  outcome         Outcome
  resolvedById    String
  resolvedBy      User     @relation(fields: [resolvedById], references: [id])

  resolverYesShares BigInt
  resolverNoShares  BigInt

  note            String?  @db.Text

  createdAt       DateTime @default(now())
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeKey  String
  earnedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, badgeKey])
  @@index([userId])
}

model Payout {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  amount    BigInt
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  market    Market   @relation(fields: [marketId], references: [id])

  @@index([userId])
  @@index([marketId])
}
